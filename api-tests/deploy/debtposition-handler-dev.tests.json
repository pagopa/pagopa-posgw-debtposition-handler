  "item": [
    {
      "name": "Debt position creation",
      "item": [
        {
          "name": "Create debt position",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// unique iupd/iuv per run, iuv as in GPD tests: segregation code + 15 random digits",
                  "const random = (n) => Array.from({ length: n }, () => Math.floor(Math.random() * 10)).join('');",
                  "pm.collectionVariables.set('IUPD', 'IUPD_POSGW_' + Date.now() + '_' + random(4));",
                  "pm.collectionVariables.set('IUV', '01' + random(15));",
                  "pm.collectionVariables.set('DUE_DATE', new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString());"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// keep the created iupd for the invalidation folder, later requests overwrite IUPD",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('CREATED_IUPD', pm.collectionVariables.get('IUPD'));",
                  "}",
                  "pm.test(\"Create debt position - Status code is 200 with created debt position\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.creditorInstitutionFiscalCode).to.eql(pm.environment.get('ORG_FISCAL_CODE'));",
                  "    pm.expect(response.iupd).to.eql(pm.collectionVariables.get('IUPD'));",
                  "    // iuv is sent, so the service echoes it and builds the notice number as aux digit + iuv",
                  "    const iuv = pm.collectionVariables.get('IUV');",
                  "    pm.expect(response.iuv).to.eql(iuv);",
                  "    pm.expect(response.noticeNumber).to.be.a('string').and.have.lengthOf(18);",
                  "    pm.expect(response.noticeNumber.substring(1)).to.eql(iuv);",
                  "    if (response.status !== undefined) {",
                  "        pm.expect(response.status).to.be.oneOf(['DRAFT', 'PUBLISHED', 'VALID', 'UNPAYABLE', 'PARTIALLY_PAID', 'PAID']);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Ocp-Apim-Subscription-Key",
                "value": "{{API_SUBSCRIPTION_KEY}}",
                "type": "text"
              },
              {
                "key": "x-correlation-id",
                "value": "{{$guid}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{HOSTNAME}}{{BASE_PATH}}/debt-positions/{{ORG_FISCAL_CODE}}",
              "host": [
                "{{HOSTNAME}}{{BASE_PATH}}"
              ],
              "path": [
                "debt-positions",
                "{{ORG_FISCAL_CODE}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"EC posgw api test\",\n  \"iupd\": \"{{IUPD}}\",\n  \"officeName\": \"Ufficio posgw api test\",\n  \"switchToExpired\": false,\n  \"debtor\": {\n    \"type\": \"F\",\n    \"fiscalCode\": \"ROSMRI87A04H501K\",\n    \"fullName\": \"Mario Rossi\"\n  },\n  \"paymentOption\": {\n    \"installment\": {\n      \"iuv\": \"{{IUV}}\",\n      \"description\": \"posgw debt position handler api test\",\n      \"dueDate\": \"{{DUE_DATE}}\",\n      \"transferList\": [\n        {\n          \"amount\": 100,\n          \"remittanceInformation\": \"posgw debt position handler api test\",\n          \"iban\": \"IT60X0542811101000000123456\",\n          \"category\": \"9/0101108TS/\"\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
